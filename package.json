{
  "name": "agent-oversign",
  "version": "0.0.0",
  "private": true,
  "description": "Human oversight for every AI agent payment. Policy enforcement for x402 payments on Solana.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:wallets": "tsx scripts/setup-wallets.ts",
    "fund:attestor": "tsx scripts/fund-attestor.ts",
    "balances": "tsx scripts/balances.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "setup:token-accounts": "tsx scripts/create-token-accounts.ts",
    "setup:tokens": "tsx scripts/setup-oversign-tokens.ts",
    "demo:servers": "concurrently -k -n merchant,creep,oversign -c green,red,cyan \"npm run merchant -w packages/attack-lab\" \"npm run attack:price-creep:server -w packages/attack-lab\" \"npm start -w apps/oversign\"",
    "demo": "npm run oversign:demo -w packages/attack-lab",
    "verify": "npm run verify -w apps/oversign",
    "demo:phone": "npm run phone:demo -w packages/attack-lab"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  }
}
